-        const prev = await this.redis.set(key, '1', 'PX', timeFrame, 'GET');
-        return prev == null;
+        const now = Date.now();
+
+        // Set the key with current timestamp, and get the previous value if it existed
+        const prev = await this.redis.set(key, now.toString(), 'PX', timeFrame, 'GET');
+
+        // If this is the first time seeing this nonce, allow it
+        if (prev == null) {
+            return true;
+        }
+
+        // If we've seen it before, check if it's within the 3-second grace period (if allowed)
